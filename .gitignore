# Local runtime state: journals, outputs, brain database. Never committed.
# Not rooted: a test or a run can create .hand/ next to any working directory, and a path-anchored
# pattern only caught the repository root.
.hand/
hand-out/
out/
data/
brain/*.db
brain/*.db-shm
brain/*.db-wal

# Release rehearsal output. The artefacts are rebuildable; only the contract is committed.
/dist/

# Python from scripts/
__pycache__/
*.pyc

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Env
.env
